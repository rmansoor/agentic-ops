# ---- LLM (pluggable) ----
LLM_PROVIDER=anthropic            # anthropic | openai
# LLM_MODEL=claude-sonnet-4-5     # override the default model for the provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- GitHub: CI mode (GitHub Actions) uses GITHUB_TOKEN; server mode uses a GitHub App ----
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=
# GITHUB_API_URL=https://github.example.com/api/v3   # GitHub Enterprise Server
AGENTIC_OPS_BOT_LOGIN=agentic-ops[bot]
AGENTIC_OPS_ALLOW_AUTO_APPROVE=false

# ---- Review tuning ----
AGENTIC_OPS_MIN_SEVERITY=minor    # nit | minor | major | critical
AGENTIC_OPS_MAX_COMMENTS=25
AGENTIC_OPS_GATE_SCOPE=lines     # lines: only gate on lines a PR adds | files: anywhere in touched files
AGENTIC_OPS_POLICY=policy.yml
AGENTIC_OPS_SEMGREP_CONFIG=semgrep/rules.yml

# ---- Slack ----
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_NOTIFY_CHANNEL=#eng-agentic-ops

# ---- SonarQube (optional) ----
SONAR_HOST_URL=
SONAR_TOKEN=
SONAR_PROJECT_KEY=

# ---- Server / IDE ----
AGENTIC_OPS_API_TOKEN=change-me   # VS Code extension sends this as a Bearer token
AGENTIC_OPS_REPO_DIR=.            # repo the /ask and Slack agent answers questions about
